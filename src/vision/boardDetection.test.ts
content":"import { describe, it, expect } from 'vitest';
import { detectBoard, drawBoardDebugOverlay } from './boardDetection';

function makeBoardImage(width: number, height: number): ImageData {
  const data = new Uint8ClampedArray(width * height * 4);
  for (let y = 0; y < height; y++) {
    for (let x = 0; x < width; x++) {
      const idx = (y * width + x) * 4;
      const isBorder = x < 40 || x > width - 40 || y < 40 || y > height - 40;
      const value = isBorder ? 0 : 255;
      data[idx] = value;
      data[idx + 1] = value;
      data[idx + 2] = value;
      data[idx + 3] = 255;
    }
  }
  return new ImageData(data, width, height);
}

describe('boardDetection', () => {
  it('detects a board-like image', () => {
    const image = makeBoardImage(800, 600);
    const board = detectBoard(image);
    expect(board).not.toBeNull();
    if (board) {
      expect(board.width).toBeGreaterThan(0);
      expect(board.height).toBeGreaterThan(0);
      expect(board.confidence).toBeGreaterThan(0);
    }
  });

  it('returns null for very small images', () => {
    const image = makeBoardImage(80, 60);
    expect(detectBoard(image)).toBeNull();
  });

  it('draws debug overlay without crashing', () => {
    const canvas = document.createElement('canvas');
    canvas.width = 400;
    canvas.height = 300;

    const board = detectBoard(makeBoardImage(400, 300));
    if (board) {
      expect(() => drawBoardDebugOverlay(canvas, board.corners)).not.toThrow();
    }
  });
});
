export interface Point {
  x: number;
  y: number;
}

export interface BoardCorners {
  topLeft: Point;
  topRight: Point;
  bottomRight: Point;
  bottomLeft: Point;
}

export interface BoardDetectionResult {
  corners: BoardCorners;
  confidence: number;
  width: number;
  height: number;
}

function luminance(r: number, g: number, b: number): number {
  return 0.299 * r + 0.587 * g + 0.114 * b;
}

function estimateBoardCornersFromEdges(image: ImageData): BoardCorners | null {
  const { width, height, data } = image;
  const step = Math.max(4, Math.floor(Math.min(width, height) / 100));

  let leftX = width;
  let rightX = 0;
  let topY = height;
  let bottomY = 0;

  let edgeHits = 0;

  for (let y = 0; y < height; y += step) {
    for (let x = 0; x < width; x += step) {
      const idx = (y * width + x) * 4;
      const gray = luminance(data[idx], data[idx + 1], data[idx + 2]);
      if (gray < 180) {
        edgeHits++;
        if (x < leftX) leftX = x;
        if (x > rightX) rightX = x;
        if (y < topY) topY = y;
        if (y > bottomY) bottomY = y;
      }
    }
  }

  if (edgeHits < 50 || leftX >= rightX || topY >= bottomY) return null;

  const pad = Math.max(12, Math.floor(Math.min(width, height) * 0.02));
  const topLeft = { x: Math.max(0, leftX - pad), y: Math.max(0, topY - pad) };
  const topRight = { x: Math.min(width - 1, rightX + pad), y: Math.max(0, topY - pad) };
  const bottomRight = { x: Math.min(width - 1, rightX + pad), y: Math.min(height - 1, bottomY + pad) };
  const bottomLeft = { x: Math.max(0, leftX - pad), y: Math.min(height - 1, bottomY + pad) };

  return { topLeft, topRight, bottomRight, bottomLeft };
}

export function detectBoard(image: ImageData): BoardDetectionResult | null {
  if (!image || image.width < 120 || image.height < 120) return null;

  const corners = estimateBoardCornersFromEdges(image);
  if (!corners) return null;

  const width = Math.hypot(corners.topRight.x - corners.topLeft.x, corners.topRight.y - corners.topLeft.y);
  const height = Math.hypot(corners.bottomLeft.x - corners.topLeft.x, corners.bottomLeft.y - corners.topLeft.y);

  if (!Number.isFinite(width) || !Number.isFinite(height) || width < 50 || height < 50) {
    return null;
  }

  const aspect = width / height;
  const confidence = Math.min(1, Math.max(0.2, 0.5 + (1 - Math.abs(aspect - 1.6) / 2) * 0.5));

  return {
    corners,
    confidence,
    width: Math.round(width),
    height: Math.round(height),
  };
}

export function drawBoardDebugOverlay(canvas: HTMLCanvasElement, corners: BoardCorners): void {
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  ctx.strokeStyle = '#ff3333';
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.moveTo(corners.topLeft.x, corners.topLeft.y);
  ctx.lineTo(corners.topRight.x, corners.topRight.y);
  ctx.lineTo(corners.bottomRight.x, corners.bottomRight.y);
  ctx.lineTo(corners.bottomLeft.x, corners.bottomLeft.y);
  ctx.closePath();
  ctx.stroke();

  const points = [corners.topLeft, corners.topRight, corners.bottomRight, corners.bottomLeft];
  for (const point of points) {
    ctx.beginPath();
    ctx.arc(point.x, point.y, 5, 0, Math.PI * 2);
    ctx.fillStyle = '#ff3333';
    ctx.fill();
  }
}

