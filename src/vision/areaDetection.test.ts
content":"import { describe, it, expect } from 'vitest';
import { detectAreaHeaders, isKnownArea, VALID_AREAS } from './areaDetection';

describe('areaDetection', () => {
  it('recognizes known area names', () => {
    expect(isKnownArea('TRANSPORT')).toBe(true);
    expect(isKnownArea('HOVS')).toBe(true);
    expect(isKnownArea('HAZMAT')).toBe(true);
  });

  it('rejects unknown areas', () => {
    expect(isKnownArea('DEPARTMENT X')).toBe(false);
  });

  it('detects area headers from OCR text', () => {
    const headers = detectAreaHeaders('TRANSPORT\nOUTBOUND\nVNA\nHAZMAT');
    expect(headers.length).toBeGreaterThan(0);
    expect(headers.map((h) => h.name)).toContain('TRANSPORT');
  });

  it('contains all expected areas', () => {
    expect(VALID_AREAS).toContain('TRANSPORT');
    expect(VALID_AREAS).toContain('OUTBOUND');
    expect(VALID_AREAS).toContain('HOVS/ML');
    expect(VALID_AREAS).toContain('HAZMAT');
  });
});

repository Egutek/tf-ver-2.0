export const VALID_AREAS = [
  'TRANSPORT',
  'OUTBOUND',
  'HOVS',
  'PUTAWAY',
  'VNA',
  'VNAS',
  'VNAC',
  'VAS',
  'OBWI',
  'OBWF',
  'HAZMAT',
  'HOVS/ML',
] as const;

export type AreaName = (typeof VALID_AREAS)[number];

export interface AreaHeader {
  name: string;
  x: number;
  y: number;
  left: number;
  right: number;
  confidence: number;
}

function normalizeAreaText(value: string): string {
  return value
    .toUpperCase()
    .replace(/[^A-Z0-9/]/g, '')
    .trim();
}

function levenshtein(a: string, b: string): number {
  const dp = Array.from({ length: a.length + 1 }, () => new Array(b.length + 1).fill(0));

  for (let i = 0; i <= a.length; i++) dp[i][0] = i;
  for (let j = 0; j <= b.length; j++) dp[0][j] = j;

  for (let i = 1; i <= a.length; i++) {
    for (let j = 1; j <= b.length; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[i][j] = Math.min(
        dp[i - 1][j] + 1,
        dp[i][j - 1] + 1,
        dp[i - 1][j - 1] + cost,
      );
    }
  }

  return dp[a.length][b.length];
}

function fuzzyMatchArea(rawText: string): { name: string; confidence: number } | null {
  const clean = normalizeAreaText(rawText);
  if (!clean) return null;

  const exact = VALID_AREAS.find((area) => area === clean);
  if (exact) return { name: exact, confidence: 0.99 };

  let best: { name: string; confidence: number } | null = null;
  let bestScore = 0.7;

  for (const area of VALID_AREAS) {
    const similarity = 1 - levenshtein(clean, area) / Math.max(clean.length, area.length);
    if (similarity > bestScore) {
      bestScore = similarity;
      best = { name: area, confidence: similarity };
    }
  }

  return best;
}

export function detectAreaHeaders(ocrText: string): AreaHeader[] {
  const detected: AreaHeader[] = [];
  const lines = ocrText.split(/\n|\r/).map((line) => line.trim()).filter(Boolean);

  for (const line of lines) {
    const words = line.split(/\s+/).filter(Boolean);
    for (const word of words) {
      const match = fuzzyMatchArea(word);
      if (!match) continue;

      const estimated = VALID_AREAS.indexOf(match.name as (typeof VALID_AREAS)[number]);
      const columnWidth = 100;
      detected.push({
        name: match.name,
        x: estimated * columnWidth,
        y: 0,
        left: estimated * columnWidth,
        right: (estimated + 1) * columnWidth,
        confidence: match.confidence,
      });
    }
  }

  return detected;
}

export function isKnownArea(value: string): boolean {
  return VALID_AREAS.includes(normalizeAreaText(value) as AreaName);
}

