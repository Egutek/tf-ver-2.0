import { describe, it, expect } from 'vitest';
import { ConfidenceLevel, combineConfidences, boostConfidence, getConfidenceLevel, meetsMinimumConfidence } from './confidence';

describe('confidence', () => {
  it('should map high confidence values to HIGH', () => {
    expect(getConfidenceLevel(0.97)).toBe(ConfidenceLevel.HIGH);
    expect(getConfidenceLevel(0.9)).toBe(ConfidenceLevel.MEDIUM);
    expect(getConfidenceLevel(0.75)).toBe(ConfidenceLevel.LOW);
  });

  it('should respect minimum confidence thresholds', () => {
    expect(meetsMinimumConfidence(0.97, ConfidenceLevel.HIGH)).toBe(true);
    expect(meetsMinimumConfidence(0.85, ConfidenceLevel.MEDIUM)).toBe(true);
    expect(meetsMinimumConfidence(0.5, ConfidenceLevel.MEDIUM)).toBe(false);
  });

  it('should combine confidences conservatively', () => {
    expect(combineConfidences(0.9, 0.8, 1)).toBeCloseTo(Math.pow(0.72, 1 / 3), 4);
  });

  it('should boost confidence for positive contextual cues', () => {
    expect(boostConfidence(0.9, { exactMatch: true })).toBeCloseTo(0.99, 3);
  });
});
