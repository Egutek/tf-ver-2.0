import { describe, it, expect } from 'vitest';
import { buildShift, moveOperator } from './shiftBuilder';
import { generateHandoverReport, exportHandoverReportText } from './handoverReport';
import type { AssignedOperator } from './areaAssignment';

describe('handoverReport', () => {
  it('should generate a basic report', () => {
    const assigned: AssignedOperator[] = [
      { name: 'NOVAK', area: 'TRANSPORT', confidence: 0.95, rect: { x: 0, y: 0, width: 50, height: 40 }, needsReview: false },
      { name: 'SVOBODA', area: 'OUTBOUND', confidence: 0.9, rect: { x: 100, y: 0, width: 50, height: 40 }, needsReview: false },
    ];

    const shift = buildShift(assigned);
    const report = generateHandoverReport(shift);
    expect(report.areaCounts['TRANSPORT']).toBe(1);
    expect(report.areaCounts['OUTBOUND']).toBe(1);
  });

  it('should include movement text', () => {
    const assigned: AssignedOperator[] = [
      { name: 'NOVAK', area: 'TRANSPORT', confidence: 0.95, rect: { x: 0, y: 0, width: 50, height: 40 }, needsReview: false },
    ];

    const shift = buildShift(assigned);
    moveOperator(shift.operators[0], 'OUTBOUND');

    const report = generateHandoverReport(shift);
    expect(report.movements[0].operator).toBe('NOVAK');
    expect(report.movements[0].from).toBe('TRANSPORT');
    expect(report.movements[0].to).toBe('OUTBOUND');
  });

  it('should export readable text', () => {
    const assigned: AssignedOperator[] = [
      { name: 'NOVAK', area: 'TRANSPORT', confidence: 0.95, rect: { x: 0, y: 0, width: 50, height: 40 }, needsReview: false },
    ];

    const report = generateHandoverReport(buildShift(assigned));
    const text = exportHandoverReportText(report);
    expect(text).toContain('SHIFT HANDOVER REPORT');
  });
});
