import { describe, it, expect, beforeEach } from 'vitest';
import { QualityBenchmark } from './qualityBenchmark';

describe('qualityBenchmark', () => {
  let benchmark: QualityBenchmark;

  beforeEach(() => {
    benchmark = new QualityBenchmark();
  });

  it('should record correct detections', () => {
    benchmark.recordImage();
    benchmark.recordCorrectDetection(0.95);
    benchmark.recordCorrectDetection(0.9);

    const metrics = benchmark.getMetrics();
    expect(metrics.magnetsCorrect).toBe(2);
    expect(metrics.magnetsDetected).toBe(2);
  });

  it('should record missed magnets', () => {
    benchmark.recordMissedMagnet();
    const metrics = benchmark.getMetrics();
    expect(metrics.magnetsMissed).toBe(1);
  });

  it('should calculate accuracy rate', () => {
    benchmark.recordCorrectDetection(0.95);
    benchmark.recordMissedMagnet();

    const metrics = benchmark.getMetrics();
    expect(metrics.accuracyRate).toBe(50);
  });

  it('should generate benchmark report', () => {
    benchmark.recordImage();
    benchmark.recordCorrectDetection(0.95);
    const result = benchmark.generateReport();
    expect(result.report).toContain('OCR QUALITY BENCHMARK REPORT');
    expect(result.metrics.accuracyRate).toBe(100);
  });
});
