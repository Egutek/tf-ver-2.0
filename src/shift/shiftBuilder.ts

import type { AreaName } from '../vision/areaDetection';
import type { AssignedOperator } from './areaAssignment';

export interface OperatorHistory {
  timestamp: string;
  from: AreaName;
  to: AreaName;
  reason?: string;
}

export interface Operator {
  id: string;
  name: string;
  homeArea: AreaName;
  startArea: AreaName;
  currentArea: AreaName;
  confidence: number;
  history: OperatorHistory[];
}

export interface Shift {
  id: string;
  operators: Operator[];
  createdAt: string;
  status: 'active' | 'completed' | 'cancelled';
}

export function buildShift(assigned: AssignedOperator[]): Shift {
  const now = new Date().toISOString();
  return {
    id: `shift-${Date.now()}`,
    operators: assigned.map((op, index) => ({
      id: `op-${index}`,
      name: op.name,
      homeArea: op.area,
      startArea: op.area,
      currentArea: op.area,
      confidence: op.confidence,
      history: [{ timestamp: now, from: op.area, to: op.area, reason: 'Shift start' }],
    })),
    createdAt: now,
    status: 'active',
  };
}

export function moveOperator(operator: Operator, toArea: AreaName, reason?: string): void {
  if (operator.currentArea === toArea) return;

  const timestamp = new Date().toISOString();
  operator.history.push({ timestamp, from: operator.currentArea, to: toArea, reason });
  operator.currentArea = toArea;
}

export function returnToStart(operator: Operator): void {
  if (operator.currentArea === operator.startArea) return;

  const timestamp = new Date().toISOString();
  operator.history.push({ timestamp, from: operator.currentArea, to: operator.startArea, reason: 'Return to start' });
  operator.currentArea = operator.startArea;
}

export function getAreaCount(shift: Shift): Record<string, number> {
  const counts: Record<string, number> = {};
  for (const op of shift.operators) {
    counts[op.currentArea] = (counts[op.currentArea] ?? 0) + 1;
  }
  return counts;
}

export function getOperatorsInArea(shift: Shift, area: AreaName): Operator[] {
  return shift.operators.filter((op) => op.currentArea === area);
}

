import { describe, it, expect } from 'vitest';
import { reviewShift, formatReviewResult, type ReviewResult } from './review';
import type { AssignedOperator } from '../shift/areaAssignment';

describe('review', () => {
  it('should block shift with no operators', () => {
    const result = reviewShift([]);
    expect(result.canProceed).toBe(false);
    expect(result.blockingIssues).toContain('No operators detected in image');
  });

  it('should block duplicates', () => {
    const ops: AssignedOperator[] = [
      { name: 'NOVAK', area: 'TRANSPORT', confidence: 0.9, rect: { x: 0, y: 0, width: 50, height: 40 }, needsReview: false },
      { name: 'NOVAK', area: 'OUTBOUND', confidence: 0.88, rect: { x: 100, y: 0, width: 50, height: 40 }, needsReview: false },
    ];

    const result = reviewShift(ops, ['NOVAK', 'SVOBODA']);
    expect(result.canProceed).toBe(false);
    expect(result.blockingIssues.some((i) => i.includes('Duplicate'))).toBe(true);
  });

  it('should warn on low confidence', () => {
    const ops: AssignedOperator[] = [
      { name: 'NOVAK', area: 'TRANSPORT', confidence: 0.7, rect: { x: 0, y: 0, width: 50, height: 40 }, needsReview: true },
    ];

    const result = reviewShift(ops, ['NOVAK']);
    expect(result.warnings.some((w) => w.includes('Low confidence'))).toBe(true);
  });

  it('should format review output', () => {
    const result: ReviewResult = {
      blockingIssues: ['Duplicate operators'],
      warnings: ['Unknown employee'],
      canProceed: false,
    };

    const output = formatReviewResult(result);
    expect(output).toContain('BLOCKING ISSUES');
    expect(output).toContain('WARNINGS');
  });
});
