import { describe, it, expect, beforeEach } from 'vitest';
import { buildShift, moveOperator, returnToStart, getAreaCount, getOperatorsInArea, type Shift } from './shiftBuilder';
import type { AssignedOperator } from './areaAssignment';

describe('shiftBuilder', () => {
  let shift: Shift;

  beforeEach(() => {
    const assigned: AssignedOperator[] = [
      { name: 'NOVAK', area: 'TRANSPORT', confidence: 0.95, rect: { x: 0, y: 0, width: 50, height: 40 }, needsReview: false },
      { name: 'SVOBODA', area: 'OUTBOUND', confidence: 0.9, rect: { x: 200, y: 0, width: 50, height: 40 }, needsReview: false },
    ];

    shift = buildShift(assigned);
  });

  it('should create a shift from assigned operators', () => {
    expect(shift.operators).toHaveLength(2);
    expect(shift.status).toBe('active');
  });

  it('should move operator to different area', () => {
    moveOperator(shift.operators[0], 'OUTBOUND', 'Moved manually');
    expect(shift.operators[0].currentArea).toBe('OUTBOUND');
    expect(shift.operators[0].history.length).toBeGreaterThan(1);
  });

  it('should return operator to start area', () => {
    moveOperator(shift.operators[0], 'OUTBOUND');
    returnToStart(shift.operators[0]);
    expect(shift.operators[0].currentArea).toBe('TRANSPORT');
  });

  it('should count operators by area', () => {
    moveOperator(shift.operators[1], 'TRANSPORT');
    const counts = getAreaCount(shift);
    expect(counts['TRANSPORT']).toBe(2);
  });

  it('should list operators in area', () => {
    const inTransport = getOperatorsInArea(shift, 'TRANSPORT');
    expect(inTransport[0].name).toBe('NOVAK');
  });
});
