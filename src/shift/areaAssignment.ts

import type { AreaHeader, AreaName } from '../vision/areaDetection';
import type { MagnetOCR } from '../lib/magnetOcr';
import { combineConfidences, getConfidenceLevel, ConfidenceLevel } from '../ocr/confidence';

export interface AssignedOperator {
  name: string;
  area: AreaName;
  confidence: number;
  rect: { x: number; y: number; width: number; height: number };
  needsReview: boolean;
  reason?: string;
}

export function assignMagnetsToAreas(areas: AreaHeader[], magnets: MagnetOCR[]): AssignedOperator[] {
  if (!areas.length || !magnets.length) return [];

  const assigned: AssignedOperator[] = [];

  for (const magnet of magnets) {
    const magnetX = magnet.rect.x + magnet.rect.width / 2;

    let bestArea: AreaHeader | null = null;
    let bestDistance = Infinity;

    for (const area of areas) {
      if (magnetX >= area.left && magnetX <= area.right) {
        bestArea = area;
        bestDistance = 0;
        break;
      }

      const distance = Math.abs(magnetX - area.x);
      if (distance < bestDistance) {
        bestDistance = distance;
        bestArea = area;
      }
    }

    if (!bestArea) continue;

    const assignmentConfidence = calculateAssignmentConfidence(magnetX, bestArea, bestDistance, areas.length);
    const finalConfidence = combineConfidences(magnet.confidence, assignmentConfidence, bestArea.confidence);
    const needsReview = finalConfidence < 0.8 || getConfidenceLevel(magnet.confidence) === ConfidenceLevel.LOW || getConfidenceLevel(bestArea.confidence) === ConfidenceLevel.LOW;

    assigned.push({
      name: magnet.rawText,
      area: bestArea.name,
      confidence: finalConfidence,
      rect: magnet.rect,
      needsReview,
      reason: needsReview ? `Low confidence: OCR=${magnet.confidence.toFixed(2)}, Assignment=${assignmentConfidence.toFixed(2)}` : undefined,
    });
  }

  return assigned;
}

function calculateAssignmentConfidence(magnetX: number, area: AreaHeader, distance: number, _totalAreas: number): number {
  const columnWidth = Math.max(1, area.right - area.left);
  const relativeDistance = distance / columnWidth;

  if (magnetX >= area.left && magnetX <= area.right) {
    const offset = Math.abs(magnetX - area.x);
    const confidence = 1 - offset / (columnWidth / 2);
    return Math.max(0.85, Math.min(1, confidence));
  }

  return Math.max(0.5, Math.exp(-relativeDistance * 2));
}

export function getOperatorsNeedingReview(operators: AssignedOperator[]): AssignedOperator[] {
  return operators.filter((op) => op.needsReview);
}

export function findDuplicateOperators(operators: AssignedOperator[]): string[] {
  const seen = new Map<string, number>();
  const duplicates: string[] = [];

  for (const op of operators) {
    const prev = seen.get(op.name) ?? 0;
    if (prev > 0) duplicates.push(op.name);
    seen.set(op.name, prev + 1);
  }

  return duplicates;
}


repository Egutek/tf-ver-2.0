import { describe, it, expect } from 'vitest';
import { VALID_AREAS, detectAreaHeaders, isValidArea } from './areaDetection';

describe('areaDetection', () => {
  it('should recognize valid area names', () => {
    expect(isValidArea('TRANSPORT')).toBe(true);
    expect(isValidArea('HOVS')).toBe(true);
    expect(isValidArea('HAZMAT')).toBe(true);
  });

  it('should reject invalid area names', () => {
    expect(isValidArea('INVALID')).toBe(false);
    expect(isValidArea('XYZ')).toBe(false);
  });

  it('should keep expected values', () => {
    expect(VALID_AREAS).toContain('TRANSPORT');
    expect(VALID_AREAS).toContain('OUTBOUND');
    expect(VALID_AREAS).toContain('HOVS/ML');
    expect(VALID_AREAS).toContain('HAZMAT');
  });

  it('should return array from blank canvas', async () => {
    const canvas = document.createElement('canvas');
    canvas.width = 500;
    canvas.height = 400;

    const ctx = canvas.getContext('2d');
    if (ctx) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    const headers = await detectAreaHeaders(canvas);
    expect(Array.isArray(headers)).toBe(true);
  });
});
